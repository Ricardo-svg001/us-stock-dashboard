{
  "contract_version": "2026-08-30.1",
  "breakout_structure": {
    "universe": 300,
    "independent_page": "/breakout-structure",
    "periods": ["6m", "1y", "2y", "5y"],
    "statuses": ["matched", "near", "developing", "none", "unavailable"],
    "screen_filters": ["matched", "near", "developing", "qualified", "all_stages"],
    "pattern_filters": ["u", "cup", "u_or_cup"],
    "developing": "current close at 80% to below 90% of prior high",
    "near": "first close at or above 90% of prior high",
    "matched": "first close at or above 98% of prior high with best 20/40/60-day gain above 30%",
    "point_in_time_replay": true,
    "early_diagnostics": ["right_side_higher_lows", "volatility_contracting", "ma20_rising", "ma60_rising"],
    "seed_file": "breakout_structure_seed.json"
  },
  "risk_watchlist": {
    "maximum_stocks": 5,
    "rs_periods": [20, 60, 120],
    "rs_universe": "current_top_300",
    "stock_analysis_default_collapsed": true,
    "includes_breakout_structure": true
  },
  "sources": {
    "us_treasury": {
      "url": "https://home.treasury.gov/resource-center/data-chart-center/interest-rates/pages/xml",
      "dataset": "daily_treasury_yield_curve"
    },
    "jgb_daily": {
      "url": "https://www.mof.go.jp/english/policy/jgbs/reference/interest_rate/jgbcme.csv"
    },
    "jgb_history": {
      "url": "https://www.mof.go.jp/english/policy/jgbs/reference/interest_rate/historical/jgbcme_all.csv"
    },
    "fred_policy": {
      "url": "https://fred.stlouisfed.org/graph/fredgraph.csv",
      "series": ["DFF", "DFEDTARL", "DFEDTARU", "IORB", "RRPONTSYD", "RPONTSYD", "WALCL", "TREAST", "WSHOMCB"]
    },
    "nyfed_effr": {
      "url": "https://markets.newyorkfed.org/api/rates/unsecured/effr/last/30.json"
    },
    "treasury_fiscal_data": {
      "url": "https://api.fiscaldata.treasury.gov/services/api/fiscal_service",
      "datasets": ["operating_cash_balance", "auctions_query"]
    },
    "fomc_calendar": {
      "url": "https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm"
    }
  },
  "allowed_lag_business_days": {
    "us_yields": 1,
    "jp_yields": 1,
    "fed_policy": 1,
    "treasury_actions": 1
  },
  "holiday_calendars": {
    "us": "US+GoodFriday",
    "jp": "JP"
  },
  "quality_statuses_zh": {
    "fresh": "資料最新",
    "pending": "尚待今日公布",
    "lag1": "落後一個交易日",
    "failed": "更新失敗，沿用舊資料",
    "overdue": "資料落後超過允許天數"
  },
  "market_phase": {
    "stage_count": 4,
    "moving_averages": [5, 10, 20, 60, 120],
    "gap_pct": 5.0,
    "riskoff_below_120ma_pct": 3.0,
    "recovery_above_120ma_pct": 4.0,
    "confirmation_days": 3,
    "tailwind_allows_5ma_below_10ma": true,
    "transition_requires_non_bullish": true,
    "recovery_watch_trigger_any": ["120ma_gt_20ma", "120ma_gt_60ma"],
    "recovery_watch_reset_on_tailwind": true,
    "carry_forward_when_unmatched": true,
    "stage_keys": ["tailwind", "transition", "riskoff", "recovery_confirmed"]
  }
}
